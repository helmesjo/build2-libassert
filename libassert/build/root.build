# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx
using c

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp
mxx{*}: extension = cppm

h{*}: extension = h
c{*}: extension = c

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target

config [bool] config.libassert.use_fmt        ?= false
config [bool] config.libassert.use_magic_enum ?= false
# config [bool] config.libassert.use_enchantum  ?= false # No build2 package available yet.
config [bool] config.libassert.no_std_format  ?= false
config [bool] config.libassert.build_testing  ?= false

if($build.mode != 'skeleton' && $config.libassert.build_testing)
  info "configured for testing \(config.libassert.build_testing=true\)"
