import libs = \
  libassert%lib{assert} \
  fmt%lib{fmt} \
  gtest%liba{gtest_main} \
  gmock%liba{gmock}

# Tests with own main() (no gtest_main):
# - constexpr_contexts
# - disambiguation
# - fmt-test (needs -DLIBASSERT_USE_FMT)
# - literals
# - test_public_utilities
# - test_type_prettier
# - type_handling

for t : cxx{* -std_format* -catch2-test \
              -constexpr_contexts \
              -disambiguation \
              -fmt-test \
              -literals \
              -test_public_utilities \
              -test_type_prettier \
              -type_handling \
           }
{
  n = $name($t)
  ./: exe{test-$n}: $t hxx{**} $libs
}

./: exe{test-fmt-test}: cxx{fmt-test} hxx{**} $libs
obj{fmt-test}: \
  cxx.poptions += -DLIBASSERT_USE_FMT

# Upstream fmtable formatter uses concrete format_context& which std::formattable rejects on GCC/Clang.
#
./: exe{test-std_format20}: include = ($cxx.id == 'msvc')
exe{test-std_format20}: cxx{std_format20} hxx{**} $libs
obj{std_format20}:
{
  cxx.mode = 20
  cxx.poptions += -DLIBASSERT_USE_FMT
}

./: exe{test-std_format23}: cxx{std_format23} hxx{**} $libs
obj{std_format23}:
{
  cxx.mode = 23
  cxx.poptions += -DLIBASSERT_USE_FMT
}

# Build options.
#
if ($cxx.target.system == 'win32-msvc')
{
  cxx.coptions += /Zc:preprocessor
  obj{assertion_tests}: cxx.coptions += /permissive-
}
